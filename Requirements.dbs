		<script name="ReqUserCat" id="f885cd64-60ee-40d7-8cba-adf408552d39" language="SQL" >
			<string><![CDATA[CREATE TABLE ReqUserCat ( 
	userCat              TEXT NOT NULL  PRIMARY KEY  ,
