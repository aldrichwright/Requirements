			<index name="pk_ReqUserCat" unique="PRIMARY_KEY" >
				<column name="userCat" />
			</index>
		</table>
		<table name="Requirements" prior="TblRequirements" >
			<column name="ReqId" type="INTEGER" mandatory="y" />
			<column name="ReqDesc" type="TEXT" length="100" />
			<column name="ReqCatType" type="TEXT" length="10" />
			<column name="ReqPrior" type="TEXT" length="6" />
			<column name="ReqInit" type="TEXT" length="10" />
			<column name="ReqRiskType" type="TEXT" length="20" />
			<column name="ReqDate" type="TEXT" length="20" />
			<column name="ReqBy" prior="ReqById" type="INT" />
			<index name="pk_Requirements" unique="PRIMARY_KEY" >
				<column name="ReqId" />
			</index>
			<fk name="fk_Requirements" to_schema="Default" to_table="User" >
				<fk_column name="ReqBy" pk="UserNo" />
			</fk>
			<fk name="fk_Requirements_0" to_schema="Default" to_table="ReqPriority" >
				<fk_column name="ReqPrior" pk="Priority" />
			</fk>
			<fk name="fk_Requirements_1" to_schema="Default" to_table="reqRisk" >
				<fk_column name="ReqRiskType" pk="Risk" />
			</fk>
			<fk name="fk_Requirements_2" to_schema="Default" to_table="reqInitiative" >
				<fk_column name="ReqInit" pk="Inititative" />
			</fk>
			<fk name="fk_Requirements_3" to_schema="Default" to_table="reqCatType" >
				<fk_column name="ReqCatType" pk="CatType" />
			</fk>
		</table>
		<table name="User" prior="Us" >
			<column name="UserId" type="INTEGER" mandatory="y" />
			<column name="UserNo" type="TEXT" length="12" />
			<column name="PassWord" prior="Password" type="TEXT" length="30" />
			<column name="UserCat" type="TEXT" length="10" />
			<index name="pk_User" unique="PRIMARY_KEY" >
				<column name="UserId" />
			</index>
			<index name="unq_User" unique="UNIQUE_KEY" >
				<column name="UserNo" />
			</index>
			<fk name="fk_User" to_schema="Default" to_table="ReqUserCat" >
				<fk_column name="UserCat" pk="userCat" />
			</fk>
		</table>
		<table name="reqCatType" prior="reqCatTy" >
			<column name="CatType" type="TEXT" mandatory="y" />
			<column name="CatTypeDesc" type="TEXT" mandatory="y" />
			<index name="pk_reqCatType" unique="PRIMARY_KEY" >
				<column name="CatType" />
			</index>
		</table>
		<table name="reqInitiative" prior="reInitiative" >
			<column name="Inititative" type="TEXT" mandatory="y" />
			<column name="InitDesc" type="TEXT" mandatory="y" />
			<index name="pk_reqInitiative" unique="PRIMARY_KEY" >
				<column name="Inititative" />
			</index>
		</table>
		<table name="reqRisk" prior="reqRis" >
