		<script name="SQL_Editor" id="10eae7e8-72ef-46d2-af1c-e92a932c3855" language="SQL" >
			<string><![CDATA[CREATE TABLE Priority ( 
	PriorityId           INT NOT NULL  PRIMARY KEY  
 );

CREATE TABLE UserCat ( 
	UserCatId            INT NOT NULL  PRIMARY KEY  ,
	UserCat              TEXT     ,
	UserCatDesc          TEXT     ,
	CONSTRAINT unq_UserCat_UserCat UNIQUE ( UserCat )
 );

CREATE TABLE User ( 
	UserId               INTEGER NOT NULL  PRIMARY KEY  ,
	UserNo               TEXT     ,
	PassWord             TEXT     ,
	UserCat              TEXT     ,
	CONSTRAINT unq_User UNIQUE ( UserNo ),
	FOREIGN KEY ( UserCat ) REFERENCES UserCat( UserCat )  
 );

CREATE TABLE Requirements ( 
	ReqId                INTEGER NOT NULL  PRIMARY KEY  ,
	ReqDesc              TEXT     ,
	ReqCatType           TEXT     ,
	ReqPrior             TEXT     ,
	ReqInit              TEXT     ,
	ReqRiskType          TEXT     ,
	ReqDate              TEXT     ,
	ReqBy                INT     ,
	FOREIGN KEY ( ReqBy ) REFERENCES User( UserNo )  ,
	FOREIGN KEY ( ReqPrior ) REFERENCES Priority( PriorityId )  
 );

]]></string>
		</script>
		<script name="SQL_Editor_001" id="14027264-1c7a-4ab8-97a9-b533b3d92ebb" language="SQL" >
			<string><![CDATA[CREATE TABLE Priority ( 
	Priority             TEXT NOT NULL  PRIMARY KEY  ,
	PriorityDesc         TEXT     
 );

CREATE TABLE UserCat ( 
	UserCatId            INT NOT NULL  PRIMARY KEY  ,
	UserCat              TEXT     ,
	UserCatDesc          TEXT     ,
	CONSTRAINT unq_UserCat_UserCat UNIQUE ( UserCat )
 );

CREATE TABLE User ( 
	UserId               INTEGER NOT NULL  PRIMARY KEY  ,
	UserNo               TEXT     ,
	PassWord             TEXT     ,
	UserCat              TEXT     ,
	CONSTRAINT unq_User UNIQUE ( UserNo ),
	FOREIGN KEY ( UserCat ) REFERENCES UserCat( UserCat )  
 );

CREATE TABLE Requirements ( 
	ReqId                INTEGER NOT NULL  PRIMARY KEY  ,
	ReqDesc              TEXT     ,
	ReqCatType           TEXT     ,
	ReqPrior             TEXT     ,
	ReqInit              TEXT     ,
	ReqRiskType          TEXT     ,
	ReqDate              TEXT     ,
	ReqBy                INT     ,
	FOREIGN KEY ( ReqBy ) REFERENCES User( UserNo )  ,
	FOREIGN KEY ( ReqPrior ) REFERENCES Priority( Priority )  
 );

]]></string>
		</script>
