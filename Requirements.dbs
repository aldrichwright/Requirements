<?xml version="1.0" encoding="UTF-8" ?>
<project name="Requirements" database="Sqlite" id="970974a6-4b55-4afa-a0fb-4863376c32b4" >
	<schema name="Default" >
		<table name="ReqPriority" prior="Priority" >
			<column name="Priority" type="TEXT" mandatory="y" />
			<column name="PriorityDesc" type="TEXT" />
			<index name="pk_Priority" unique="PRIMARY_KEY" >
				<column name="Priority" />
			</index>
		</table>
		<table name="ReqUserCat" prior="ReqUserCa" >
